{
    "name": "gem-duel-monorepo",
    "private": true,
    "version": "2.0.0",
    "description": "Greenfield Gem Duel monorepo with a deterministic core engine, Next.js web app, room service, and Electron shell.",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "check-boundaries": "eslint . --ext .ts,.tsx,.mts,.cts --max-warnings 0",
        "check-commit": "node ./tools/check-commit.mjs",
        "check-contracts": "corepack pnpm contracts:verify && corepack pnpm --filter @gem-duel/contracts test",
        "check-deps": "depcruise --config .dependency-cruiser.cjs apps packages tools",
        "check-phase4": "node ./tools/check-phase4.mjs",
        "check-visual": "node ./tools/check-visual.mjs",
        "contracts:generate": "corepack pnpm --filter @gem-duel/contracts generate",
        "contracts:verify": "corepack pnpm --filter @gem-duel/contracts verify:generated",
        "dev": "node ./tools/run-turbo.mjs run dev --parallel",
        "dev:web": "corepack pnpm --filter @gem-duel/web dev",
        "dev:room": "corepack pnpm --filter @gem-duel/room-service dev",
        "dev:desktop": "corepack pnpm --filter @gem-duel/desktop dev",
        "build": "node ./tools/run-turbo.mjs run build",
        "build:web": "corepack pnpm --filter @gem-duel/web build",
        "build:room": "corepack pnpm --filter @gem-duel/room-service build",
        "build:desktop": "corepack pnpm --filter @gem-duel/desktop build",
        "lint": "node ./tools/run-turbo.mjs run lint",
        "test": "node ./tools/run-turbo.mjs run test",
        "typecheck": "node ./tools/run-turbo.mjs run typecheck",
        "format": "prettier --write .",
        "prepare": "husky",
        "legacy:notes": "node -e \"console.log('Legacy extracts now live in ./docs/99-legacy and deeper archaeology should use git history rather than a live legacy source tree.')\""
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs,json,md,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@playwright/test": "^1.51.1",
        "@eslint/js": "^9.38.0",
        "@fast-check/vitest": "^0.3.0",
        "@types/node": "^24.6.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "dependency-cruiser": "^17.3.10",
        "eslint": "^9.38.0",
        "eslint-plugin-boundaries": "^6.0.2",
        "eslint-plugin-react-hooks": "^5.2.0",
        "fast-check": "^4.7.0",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.0",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "turbo": "^2.5.8",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.1",
        "vitest": "^3.2.4"
    }
}
